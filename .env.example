# Local development baseline. Staging and production values come from their
# deployment/secret-management configuration and must never be committed here.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Debug mode is allowed locally only; the application rejects it in staging and production.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_STRUCTURED_STREAM=php://stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=turf_booking_local
DB_USERNAME=turf_booking_app
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
DB_QUEUE_LONG=media
DB_QUEUE_LONG_RETRY_AFTER=300
DB_QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
CACHE_PREFIX=turf_booking:local:cache:
RATE_LIMITER_STORE=database
API_RATE_LIMIT_PER_MINUTE=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache_locks
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_USERNAME=null
REDIS_CACHE_PASSWORD=null
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=1
REDIS_CACHE_LOCK_HOST=127.0.0.1
REDIS_CACHE_LOCK_USERNAME=null
REDIS_CACHE_LOCK_PASSWORD=null
REDIS_CACHE_LOCK_PORT=6379
REDIS_CACHE_LOCK_DB=2
REDIS_RATE_LIMITER_CONNECTION=rate_limiter
REDIS_RATE_LIMITER_HOST=127.0.0.1
REDIS_RATE_LIMITER_USERNAME=null
REDIS_RATE_LIMITER_PASSWORD=null
REDIS_RATE_LIMITER_PORT=6379
REDIS_RATE_LIMITER_DB=3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
